# Local development settings for the talent pipeline.
# Usage (from the repo root):  source data/talent-pipeline/env.local
#
# Only local defaults live here (local Postgres + LocalStack); there are no real secrets.
# In the cloud these variables are injected by Terraform/Helm instead.

# --- Runtime mode -------------------------------------------------------------
export IS_LOCAL=true

# --- Source system 1: PostgreSQL (HR database) --------------------------------
export POSTGRES_HOST=localhost
export POSTGRES_PORT=5432
export POSTGRES_NAME=postgres
export POSTGRES_USER=postgres
export POSTGRES_PASS=postgres123

# --- Source system 2 + data lake: S3 (LocalStack) ------------------------------
# Bucket name must match the IAM pattern coding-workshop*<participant_id>*
export LAKE_BUCKET="coding-workshop-datalake-${PARTICIPANT_ID:-d59e2ef7}"
export AWS_ENDPOINT_URL=http://localhost.localstack.cloud:4566
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_REGION=us-east-1
unset AWS_SESSION_TOKEN AWS_PROFILE

# --- Spark / Java -------------------------------------------------------------
export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# Use the PySpark installed in .venv (pinned in requirements.txt, same as the cloud job),
# not the system Spark that ~/.bashrc points SPARK_HOME at.
unset SPARK_HOME
